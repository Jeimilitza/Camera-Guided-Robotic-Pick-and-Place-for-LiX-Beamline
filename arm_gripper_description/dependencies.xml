<?xml version="1.0"?>
<?xml-model href="http://ros.org" schematypens="http://w3.org"?>
<package format="3">
  <name>arm_gripper_description</name>
  <version>0.1.0</version>
  <description>Arm gripper control with Vimba camera and AprilTag detection</description>
  <maintainer email="jsainzlop@bnl.gov.com">Jeimilitza</maintainer>
  <license>Apache-2.0</license>

  <!-- ROS 2 Core & Message Dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- MoveIt 2 Python Wrapper -->
  <exec_depend>pymoveit2</exec_depend>

  <!-- System Python Libraries -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Testing / Linting -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
